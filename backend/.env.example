# ==============================================================================
# COLISTRACK CAMEROUN V2 — Configuration Environnement (Modèle de Développement)
# Ce fichier sert uniquement de modèle non sensible pour le développement local.
# Ne JAMAIS renseigner de clés ou secrets de production dans ce fichier.
# ==============================================================================

# Environnement d'exécution : 'development', 'testing', ou 'production'
ENVIRONMENT=development

# Nom officiel et version sémantique du service
APP_NAME="ColisTrack Cameroun API"
APP_VERSION="2.0.0"

# Port d'écoute interne du processus FastAPI dans le conteneur
PORT=8000

# Port d'écoute sur la machine hôte pour Docker Compose
# Mappé par défaut sur 8001 pour éviter tout conflit avec le port 8000 utilisé par Docker Desktop
HOST_PORT=8001

# Port hôte pour PostgreSQL (mappé sur 5433 pour éviter le conflit avec le port 5432)
POSTGRES_HOST_PORT=5433

# URLs de connexion PostgreSQL (valeurs factices pour développement local)
# Pilote asynchrone pour FastAPI (asyncpg) :
DATABASE_URL=postgresql+asyncpg://colistrack_user:colistrack_dev_password@localhost:5433/colistrack_db
# Pilote synchrone pour les migrations Alembic (psycopg2) :
SYNC_DATABASE_URL=postgresql+psycopg2://colistrack_user:colistrack_dev_password@localhost:5433/colistrack_db

# Origines CORS autorisées (format liste JSON ou séparées par virgules)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8001"]

# Clé secrète de signature interne (valeur minimale factice pour développement local)
SECRET_KEY=dev-insecure-secret-key-change-in-production-min32chars!

# Configuration JWT (authentification et signature de jetons)
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-min32chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER="colistrack-api"
JWT_AUDIENCE="colistrack-client"

# Chiffrement symétrique des données sensibles (AES-256-GCM)
# La clé doit être une chaîne hexadécimale de 64 caractères (32 octets)
DATA_ENCRYPTION_PRIMARY_KEY_ID="k1"
DATA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
DATA_ENCRYPTION_OLD_KEYS="{}"

# Limitation de débit (Rate-Limiting)
RATE_LIMITING_ENABLED=true
RATE_LIMIT_LOGIN=10
RATE_LIMIT_CHANGE_PASSWORD=10
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTH_READ=60
RATE_LIMIT_AGENCY_CONTEXT=20
RATE_LIMIT_ADMIN=20
# URL Redis (optionnelle en développement local, active le limiteur distribué si renseignée)
# REDIS_URL=redis://localhost:6379/0
TRUSTED_PROXIES=["127.0.0.1","::1"]
